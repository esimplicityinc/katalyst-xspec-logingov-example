# Permit Renewal tests: Next.js frontend on :3000 (proxies /v1/* to the BFF),
# BFF on :8000 that owns /v1/auth/start and /v1/auth/callback, Keycloak as
# login.gov with an authenticator app (TOTP). Copy to .env: cp .env.example .env

# ── Where to test ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# API steps call the BFF directly; the session cookie is for localhost, so it
# works on both ports.
API_BASE_URL=http://localhost:8000
HEADLESS=true

# ── How logging in works ───────────────────────────────────────
# The BFF's login route, through the frontend (Next.js adds the trailing slash).
UI_LOGIN_PATH=/v1/auth/start
# API steps send the browser login's __Host-ses cookie.
API_AUTH_MODE=ui-session
# A route that needs a session: "/" is public, so it can't tell a saved session
# has expired; /v1/application/ answers 401 when it has.
UI_SESSION_CHECK_PATH=/v1/application/

# ── Who logs in ────────────────────────────────────────────────
AUTH_APPLICANT_USERNAME=facial@test.local
AUTH_APPLICANT_PASSWORD=password

# ── One-time codes (authenticator app, TOTP) ───────────────────
AUTH_OTP_SECRET=logingov-local-otp-secret
AUTH_OTP_ENCODING=latin1
