# Benefits app tests: login.gov-style login (Keycloak locally) with an
# authenticator app (TOTP), a BFF that owns /auth/start and /auth/callback,
# and an API that only accepts the session cookie.
# Copy to .env:  cp .env.example .env

# ── Where to test ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:4100
HEADLESS=true

# ── How logging in works ───────────────────────────────────────
# The login starts at the app's own route, which redirects to the identity
# provider. Any page outside FRONTEND_URL counts as part of the login.
UI_LOGIN_PATH=/auth/start
# API steps use the browser login's session cookie (the API takes no tokens).
API_AUTH_MODE=ui-session
# A page that needs a login: a restored session that lands on the identity
# provider from here has expired, and the role signs in again.
UI_SESSION_CHECK_PATH=/

# ── Who logs in ────────────────────────────────────────────────
# "applicant": identity-verified (IAL2), can apply for benefits.
AUTH_APPLICANT_USERNAME=facial@test.local
AUTH_APPLICANT_PASSWORD=password
# "unverified": signed in but not identity-verified (IAL1).
AUTH_UNVERIFIED_USERNAME=basic@test.local
AUTH_UNVERIFIED_PASSWORD=password
# "admin": a caseworker with its own authenticator secret (below). Not used by
# these features; shows a per-role OTP secret.
AUTH_ADMIN_USERNAME=caseworker@test.local
AUTH_ADMIN_PASSWORD=caseworker-password

# ── One-time codes (authenticator app, TOTP) ───────────────────
# Every test user's authenticator secret. Keycloak's OTP secrets are plain
# text, hence latin1. A role's own AUTH_<ROLE>_OTP_SECRET wins.
AUTH_OTP_SECRET=logingov-local-otp-secret
AUTH_OTP_ENCODING=latin1
AUTH_ADMIN_OTP_SECRET=caseworker-otp-secret

# ── Cleanup ────────────────────────────────────────────────────
# Each user can only delete their own applications, so clean up as the applicant.
CLEANUP_AUTH_ROLE=applicant
