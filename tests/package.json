{
  "name": "benefits-app-tests",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen": "bddgen",
    "gen:stubs": "katalyst-xspec stubs",
    "test": "bddgen && playwright test",
    "check-updates": "katalyst-xspec upgrade --check",
    "upgrade": "katalyst-xspec upgrade",
    "upgrade:migrate": "katalyst-xspec upgrade --migrate",
    "clean:gen": "rm -rf .features-gen",
    "clean": "rm -rf .features-gen node_modules test-results storage cucumber-report playwright-report",
    "app": "node ../app/server.mjs",
    "keycloak:up": "docker compose -f ../docker-compose.yml up -d --wait",
    "keycloak:down": "docker compose -f ../docker-compose.yml down"
  },
  "devDependencies": {
    "@esimplicitylabs/katalyst-xspec": "^0.19.3",
    "@playwright/test": "^1.49.0",
    "dotenv": "^16.1.4",
    "playwright-bdd": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
